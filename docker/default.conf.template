# RRQuilts static host. ${RRQ_BASE} is substituted at container start (nginx templates).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location = / {
        return 302 ${RRQ_BASE};
    }

    location ${RRQ_BASE} {
        alias /usr/share/nginx/html/;
        # History-mode SPA: unknown paths get the app shell.
        try_files $uri $uri/ ${RRQ_BASE}index.html;

        # Content-hashed build assets never change.
        location ~* /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
        # Shell, service worker, and manifest must be revalidated so updates are seen.
        location ~* /(index\.html|404\.html|sw\.js|manifest\.json)$ {
            add_header Cache-Control "no-cache";
        }
    }
}
