{
  "extends": "./.quasar/tsconfig.json",
  "//": "exclude repeats .quasar/tsconfig.json's (it replaces them) and adds large non-source folders, which vue-tsc would otherwise watch",
  "exclude": [
    "./dist",
    "./node_modules",
    "./src-capacitor",
    "./src-cordova",
    "./quasar.config.*.temporary.compiled*",
    "./src-pwa/sw",
    "./docs",
    "./fabric_collections",
    "./reference",
    "./specs",
    "./.specify"
  ],
  "watchOptions": {
    "excludeDirectories": [
      "./node_modules",
      "./docs",
      "./fabric_collections",
      "./reference",
      "./specs",
      "./.specify"
    ]
  }
}
